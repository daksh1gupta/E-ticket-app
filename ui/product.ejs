<!DOCTYPE html>
<html lang="en">
<head>
   <title><%= title %></title>
</head>
<style>
    body{
        font-family: 'Times New Roman', Times, serif;
        margin : 0;
        background: #f5f5f5;
    }
    .container{
        display: flex;
        gap: 20px;
        padding: 20px;   
    }
    .box{
        width: 50%;
        background: white;
        border: 2px solid black;
        border-radius: 5px;
        padding: 10px;
    }
    textarea{
        width: 100%;
        height: 200px;
        border: none;
        outline: none;
        font-size: 12px;
    }
    iframe{
        width: 100%;
        height: 400px;
        border: none;
    }
    h4{
        margin-top: 0;
    }
</style>
<body>
    <%- include("header") %>

    <h3 style="margin: 20px;">Code Editor</h3>
    <div class="container">
        <div class="box">
            <h4>My code Place</h4>
            <textarea id="code" placeholder="Write your code......"></textarea>
        </div>
        <div class="box">
            <h4>Preview</h4>
            <iframe id="Preview"></iframe>
        </div>
    </div>
    <script>
        const code = document.getElementById("code");
        const preview = Document.getElementById("preview");

        code.addEventListener("keyup", ()=>{
            preview.srcdoc = code.value;
        })
    </script>
</body>
</html>